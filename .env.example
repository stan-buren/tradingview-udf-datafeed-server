# ═══════════════════════════════════════════════════════════════════
# TradingView UDF Datafeed Server — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Every variable has a sensible default (see src/udf_server/config.py).
# Uncomment any line to override.

# ─── Project ──────────────────────────────────────────────────────
# PROJECT_ROOT=/app                  # Override auto-detected project root

# ─── Server ───────────────────────────────────────────────────────
# UDF_PORT=8088                      # Server port
# UDF_HOST=0.0.0.0                   # Bind address

# ─── Binance REST API ─────────────────────────────────────────────
# BINANCE_REST_URL=https://api.binance.com
# BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# BINANCE_REQUEST_TIMEOUT=10.0
# BINANCE_MAX_KLINES_PER_REQUEST=1000
# BINANCE_RATE_LIMIT_RPM=1200
# BINANCE_MAX_RETRIES=3

# ─── History Endpoint ─────────────────────────────────────────────
# DEFAULT_HISTORY_LIMIT=500
# HISTORY_MAX_LIMIT=1000

# ─── Symbol Cache (SQLite) ────────────────────────────────────────
# SYMBOLS_DB_PATH=data/symbols.db
# SYMBOL_SYNC_BATCH_SIZE=500
# SYMBOL_SEARCH_LIMIT=100

# ─── WebSocket Bridge ─────────────────────────────────────────────
# WS_RECONNECT_DELAY=1.0
# WS_RECONNECT_MAX_DELAY=30.0
# WS_RECONNECT_BACKOFF=2.0
# WS_PING_INTERVAL=180.0

# ─── Bar Cache (in-memory) ────────────────────────────────────────
# BAR_CACHE_MAX_BARS=2000

# ─── Frontend ─────────────────────────────────────────────────────
# FRONTEND_DIR=frontend             # Path to static demo files

# ─── ENTSO-E Energy Data (DuckDB adapter) ────────────────────────
# Required for Energy mode. Skip for Binance-only deployment.
# S3_ENDPOINT=localhost:8333         # SeaweedFS / MinIO S3 endpoint
# S3_ACCESS_KEY=change-me            # S3 access key
# S3_SECRET_KEY=change-me            # S3 secret key
# S3_BUCKET=lakehouse-tables         # S3 bucket with Parquet files
# ENERGY_PRICE_MIN=-500.0            # Floor for price filter (EUR/MWh)
# ENERGY_PRICE_MAX=3000.0            # Ceiling for price filter (EUR/MWh)
